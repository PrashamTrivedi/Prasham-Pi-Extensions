{
  "budget": 8,
  "permissions": {
    "bash": {
      "deny": [
        "rm -rf /",
        "sudo rm",
        "git push --force",
        "git push -f",
        "mkfs",
        ":(){:|:&};:"
      ],
      "confirm": [
        "git push",
        "git reset --hard",
        "rm -rf",
        "rm -r ",
        "sudo",
        "chmod",
        "chown",
        "curl",
        "wget",
        "npm publish",
        "npm install",
        "npm i ",
        "bun add",
        "pnpm add",
        "yarn add",
        "brew",
        "apt-get",
        "docker"
      ]
    },
    "paths": {
      "deny": [".env", ".ssh", "id_rsa", "id_ed25519", ".aws", ".npmrc", ".netrc", ".git-credentials"],
      "confirmOutsideCwd": true
    },
    "tools": {
      "deny": [],
      "confirm": []
    }
  }
}
